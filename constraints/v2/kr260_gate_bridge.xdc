# Generated by scripts/v2/gate/gen_kr260_gate_xdc.py from the Vivado KR260 board files

set_property PACKAGE_PIN D4 [get_ports {a_rxc}]  ;# som240_1_d10
set_property IOSTANDARD LVCMOS18 [get_ports {a_rxc}]
set_property PACKAGE_PIN A1 [get_ports {a_rd[0]}]  ;# som240_1_a4
set_property IOSTANDARD LVCMOS18 [get_ports {a_rd[0]}]
set_property PACKAGE_PIN B3 [get_ports {a_rd[1]}]  ;# som240_1_b7
set_property IOSTANDARD LVCMOS18 [get_ports {a_rd[1]}]
set_property PACKAGE_PIN A3 [get_ports {a_rd[2]}]  ;# som240_1_b8
set_property IOSTANDARD LVCMOS18 [get_ports {a_rd[2]}]
set_property PACKAGE_PIN B4 [get_ports {a_rd[3]}]  ;# som240_1_c9
set_property IOSTANDARD LVCMOS18 [get_ports {a_rd[3]}]
set_property PACKAGE_PIN A4 [get_ports {a_rx_ctl}]  ;# som240_1_c10
set_property IOSTANDARD LVCMOS18 [get_ports {a_rx_ctl}]
set_property PACKAGE_PIN A2 [get_ports {a_txc}]  ;# som240_1_a3
set_property IOSTANDARD LVCMOS18 [get_ports {a_txc}]
set_property PACKAGE_PIN E1 [get_ports {a_td[0]}]  ;# som240_1_d7
set_property IOSTANDARD LVCMOS18 [get_ports {a_td[0]}]
set_property PACKAGE_PIN D1 [get_ports {a_td[1]}]  ;# som240_1_d8
set_property IOSTANDARD LVCMOS18 [get_ports {a_td[1]}]
set_property PACKAGE_PIN F2 [get_ports {a_td[2]}]  ;# som240_1_d4
set_property IOSTANDARD LVCMOS18 [get_ports {a_td[2]}]
set_property PACKAGE_PIN E2 [get_ports {a_td[3]}]  ;# som240_1_d5
set_property IOSTANDARD LVCMOS18 [get_ports {a_td[3]}]
set_property PACKAGE_PIN F1 [get_ports {a_tx_ctl}]  ;# som240_1_c4
set_property IOSTANDARD LVCMOS18 [get_ports {a_tx_ctl}]
set_property PACKAGE_PIN G3 [get_ports {a_mdc}]  ;# som240_1_c6
set_property IOSTANDARD LVCMOS18 [get_ports {a_mdc}]
set_property PACKAGE_PIN F3 [get_ports {a_mdio}]  ;# som240_1_c7
set_property IOSTANDARD LVCMOS18 [get_ports {a_mdio}]
set_property PACKAGE_PIN B1 [get_ports {a_rst_n}]  ;# som240_1_b2
set_property IOSTANDARD LVCMOS18 [get_ports {a_rst_n}]
set_property PACKAGE_PIN K4 [get_ports {b_rxc}]  ;# som240_2_c11
set_property IOSTANDARD LVCMOS18 [get_ports {b_rxc}]
set_property PACKAGE_PIN H1 [get_ports {b_rd[0]}]  ;# som240_2_a21
set_property IOSTANDARD LVCMOS18 [get_ports {b_rd[0]}]
set_property PACKAGE_PIN K2 [get_ports {b_rd[1]}]  ;# som240_2_b15
set_property IOSTANDARD LVCMOS18 [get_ports {b_rd[1]}]
set_property PACKAGE_PIN J2 [get_ports {b_rd[2]}]  ;# som240_2_b16
set_property IOSTANDARD LVCMOS18 [get_ports {b_rd[2]}]
set_property PACKAGE_PIN H4 [get_ports {b_rd[3]}]  ;# som240_2_a14
set_property IOSTANDARD LVCMOS18 [get_ports {b_rd[3]}]
set_property PACKAGE_PIN H3 [get_ports {b_rx_ctl}]  ;# som240_2_a15
set_property IOSTANDARD LVCMOS18 [get_ports {b_rx_ctl}]
set_property PACKAGE_PIN J1 [get_ports {b_txc}]  ;# som240_2_a20
set_property IOSTANDARD LVCMOS18 [get_ports {b_txc}]
set_property PACKAGE_PIN U9 [get_ports {b_td[0]}]  ;# som240_2_d12
set_property IOSTANDARD LVCMOS18 [get_ports {b_td[0]}]
set_property PACKAGE_PIN V9 [get_ports {b_td[1]}]  ;# som240_2_d13
set_property IOSTANDARD LVCMOS18 [get_ports {b_td[1]}]
set_property PACKAGE_PIN U8 [get_ports {b_td[2]}]  ;# som240_2_c17
set_property IOSTANDARD LVCMOS18 [get_ports {b_td[2]}]
set_property PACKAGE_PIN V8 [get_ports {b_td[3]}]  ;# som240_2_c18
set_property IOSTANDARD LVCMOS18 [get_ports {b_td[3]}]
set_property PACKAGE_PIN Y8 [get_ports {b_tx_ctl}]  ;# som240_2_d16
set_property IOSTANDARD LVCMOS18 [get_ports {b_tx_ctl}]
set_property PACKAGE_PIN R8 [get_ports {b_mdc}]  ;# som240_2_b24
set_property IOSTANDARD LVCMOS18 [get_ports {b_mdc}]
set_property PACKAGE_PIN T8 [get_ports {b_mdio}]  ;# som240_2_b25
set_property IOSTANDARD LVCMOS18 [get_ports {b_mdio}]
set_property PACKAGE_PIN K1 [get_ports {b_rst_n}]  ;# som240_2_b19
set_property IOSTANDARD LVCMOS18 [get_ports {b_rst_n}]
set_property PACKAGE_PIN C3 [get_ports {clk25}]  ;# som240_1_a6
set_property IOSTANDARD LVCMOS18 [get_ports {clk25}]

# ---- clocks
create_clock -name clk25 -period 40.000 [get_ports clk25]
create_clock -name a_rxc -period 40.000 [get_ports a_rxc]
create_clock -name b_rxc -period 40.000 [get_ports b_rxc]
set_clock_groups -asynchronous -group [get_clocks -include_generated_clocks clk25] -group [get_clocks a_rxc] -group [get_clocks b_rxc]

# ---- RGMII receive (sdr100-aligned data on both RXC edges)
set_input_delay -clock a_rxc -max 38.500 [get_ports {a_rd[*] a_rx_ctl}]
set_input_delay -clock a_rxc -min 37.500 [get_ports {a_rd[*] a_rx_ctl}]
set_false_path -fall_to [get_clocks a_rxc] -through [get_ports {a_rd[*] a_rx_ctl}]
set_input_delay -clock b_rxc -max 38.500 [get_ports {b_rd[*] b_rx_ctl}]
set_input_delay -clock b_rxc -min 37.500 [get_ports {b_rd[*] b_rx_ctl}]
set_false_path -fall_to [get_clocks b_rxc] -through [get_ports {b_rd[*] b_rx_ctl}]

# ---- RGMII transmit: TXC, TD and TX_CTL all leave through ODDRE1 on the same clock
# (edge-aligned; the PHY adds the TX clock delay).  Launch skew is checked in the
# routed report_datasheet output rather than with output-delay constraints.
set_false_path -to [get_ports {a_txc a_td[*] a_tx_ctl b_txc b_td[*] b_tx_ctl}]
set_property SLEW FAST [get_ports {a_txc a_td[*] a_tx_ctl b_txc b_td[*] b_tx_ctl}]

# ---- slow management pins
set_false_path -to [get_ports {a_mdc a_mdio a_rst_n b_mdc b_mdio b_rst_n}]
set_false_path -from [get_ports {a_mdio b_mdio}]
set_property PULLUP true [get_ports {a_mdio b_mdio}]
